# Copy to deploy/.env and replace every value. Never commit real secrets (deploy/.env is git-ignored).
PUBLIC_BASE_URL=https://broadcast.example.com
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me-64-hex-chars
MEDIA_TOKEN_SECRET=change-me-64-hex-chars
HLS_LADDER=1080p:1920:5000:192,720p:1280:2800:128,480p:854:1400:96,360p:640:800:96
MAX_CONCURRENT_STREAMS=4
CASPARCG_ENABLED=false
# Optional CasparCG image. None is bundled; see docs/casparcg.md.
CASPARCG_IMAGE=
