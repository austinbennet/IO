# Copy to .env and replace every value. Never commit real secrets.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
IO_PUBLIC_BASE_URL=http://localhost:8080
IO_DATA_DIR=/home/user/io/data
DATABASE_URL=change-me
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me
MEDIA_TOKEN_SECRET=change-me
HLS_LADDER=360p:360:800:96,240p:240:400:64
X264_PRESET=ultrafast
HEALTH_INTERVAL_MS=30000
RECORDING_MIN_FREE_GB=1
MAX_CONCURRENT_STREAMS=2
ALLOW_PRIVATE_SOURCE_HOSTS=127.0.0.1
